class Clinte {
    constructor(nome, banco, saldo) {
        this.nome = nome;
        this.banco = banco;
        this.saldo = saldo;
    }

    exibircliente() {
        console.log(`cliente: $(this.nome)`);
        console.log(`banco: $(this.banco)`);
        console.log(`saldo: $(this.saldo)`);
    }

    correcaosaldo(porcentagem) {
        return this.saldo * (1+porcentagem/100);

    }
}

